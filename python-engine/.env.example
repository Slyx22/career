# ---- Python engine environment configuration ----

# Comma-separated list of origins allowed to call this API (CORS).
ALLOWED_ORIGINS=http://localhost:3000

# Storage backend: "local" (SQLite, default, no external service needed)
# or "supabase" (implement app/db/supabase_store.py before using this).
STORAGE_BACKEND=local

# Only used when STORAGE_BACKEND=local. Defaults to a file inside this folder.
LOCAL_DB_PATH=./local_dev.db

# Used to build the "Verified at" line printed on certificate PDFs.
# Leave blank in development. Set to your real domain when you launch,
# e.g. https://career-readiness.example.com
PUBLIC_VERIFY_URL_BASE=

# --- Supabase (not required to run locally, fill in later) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Optional AI API (Phase 1 works fully without this) ---
# Used only to rephrase recommendations more naturally if implemented later.
# The Python scoring engine remains the sole authority on the score.
# AI_API_KEY=
