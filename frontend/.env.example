# ---- Frontend environment configuration ----

# URL of the Python FastAPI engine. In local development this points at
# your locally running FastAPI server (see python-engine/README section in
# the root README). Do NOT invent a production URL here - set the real one
# yourself once the Python engine is deployed.
PYTHON_API_URL=http://localhost:8000

# Public base URL of this frontend, used to build the certificate
# verification link shown on the certificate PDF. Leave blank locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (optional, not required to run Phase 1 locally) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Clerk (optional - Phase 2 accounts. Core flow works without it) ---
# Get these free at https://dashboard.clerk.com after creating an
# application. See README "Integrating Clerk" for the full walkthrough.
# Leaving these blank keeps the app running exactly as before - sign-in
# UI and the /dashboard route simply won't be active.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Optional AI API (Phase 1 works fully without this) ---
AI_API_KEY=
